{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{ "source": "/site.webmanifest", "destination": "/images/site.webmanifest", "permanent": true },
		{ "source": "/images/favicon.ico", "destination": "/favicon.ico", "permanent": true }
	],
	"headers": [
		{
			"source": "/",
			"headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
		},
		{
			"source": "/index.md",
			"headers": [
				{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
				{ "key": "Vary", "value": "Accept, Accept-Encoding" },
				{ "key": "X-Robots-Tag", "value": "googlebot: noindex, follow" }
			]
		},
		{
			"source": "/llms.txt",
			"headers": [
				{ "key": "Content-Type", "value": "text/plain; charset=utf-8" },
				{ "key": "Vary", "value": "Accept, Accept-Encoding" },
				{ "key": "X-Robots-Tag", "value": "googlebot: noindex, follow" }
			]
		},
		{
			"source": "/cv.yaml",
			"headers": [
				{ "key": "Content-Type", "value": "text/yaml; charset=utf-8" },
				{ "key": "X-Robots-Tag", "value": "googlebot: noindex, follow" }
			]
		}
	]
}
