---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import IconHouse from '@/assets/icons/IconHouse.astro';

interface Props {
	pageTitle: string;
	pageDescription: string;
	heading: string;
}

const { pageTitle, pageDescription, heading } = Astro.props;

const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription} canonicalPath={canonicalPath}>
	<section class="bg-primary dark:bg-primary-dark transition-colors duration-300 ease-in-out p-3 sm:p-6 lg:p-10 min-h-dvh">
		<article class="section mx-auto max-w-2xl py-10 lg:py-16">
			<h1 class="text-3xl lg:text-4xl font-bold text-text dark:text-text-dark transition-colors duration-300 ease-in-out">{heading}</h1>
			<div class="prose-page mt-6 lg:mt-8 space-y-4 text-text dark:text-text-dark transition-colors duration-300 ease-in-out">
				<slot />
			</div>
			<Button href="/" className="w-fit mt-10" variants="accent" size="md" attr={{ title: 'Ir a la página principal' }}>
				<IconHouse width={16} height={16} class="transition-all ease-in-out duration-300" />
				Volver al inicio
			</Button>
		</article>
	</section>
</Layout>

<style is:global>
	.prose-page a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.prose-page h2 {
		font-size: 1.25rem;
		font-weight: 600;
		margin-top: 1.75rem;
	}

	.prose-page ul {
		list-style: disc;
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
</style>
