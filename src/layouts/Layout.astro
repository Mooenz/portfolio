---
import '@/styles/global.css';
import '@/styles/fonts.css';

import seo, { SITE_URL, BRAND } from '@/constants/seo.ts';
import projects from '@/constants/projects.ts';
import personal from '@/constants/personal-info.ts';
import ButtonTop from '@/components/ButtonTop.astro';
import Footer from '@/components/Footer.astro';

interface Props {
	noindex?: boolean;
	nofollow?: boolean;
	pageTitle?: string;
	pageDescription?: string;
	canonicalPath?: string;
}

const {
	noindex = false,
	nofollow = false,
	pageTitle = seo.title,
	pageDescription = seo.description,
	canonicalPath,
} = Astro.props;

const { fbAppId, og } = seo;
const canonical = canonicalPath ? new URL(canonicalPath, SITE_URL).href : seo.canonical;
const ogUrl = canonical;
const robotsContent = noindex ? (nofollow ? 'noindex,nofollow' : 'noindex,follow') : 'index,follow';

const currentYear = new Date().getFullYear();
const currentDate = new Date().toISOString();

const postalAddress = {
	'@type': 'PostalAddress',
	addressLocality: BRAND.locality,
	addressRegion: BRAND.region,
	addressCountry: BRAND.countryCode,
};

const sameAsProfiles = [
	'https://github.com/Mooenz',
	'https://www.linkedin.com/in/mooenz/',
	'https://twitter.com/MooenzDev',
	'https://x.com/MooenzDev',
];

const personSchema = {
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: BRAND.legalName,
	alternateName: [BRAND.name, `${BRAND.name} (${BRAND.legalName})`],
	url: `${SITE_URL}/`,
	email: `mailto:${personal.email}`,
	image: {
		'@type': 'ImageObject',
		url: `${SITE_URL}/images/og-image.webp`,
		width: 1200,
		height: 630,
	},
	description: pageDescription,
	jobTitle: 'Desarrollador Frontend',
	worksFor: {
		'@id': `${SITE_URL}/#organization`,
	},
	address: postalAddress,
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'sales',
		email: personal.email,
		url: `${SITE_URL}/contact`,
		availableLanguage: ['es', 'en'],
	},
	sameAs: sameAsProfiles,
	knowsAbout: [
		'Desarrollo Web',
		'JavaScript',
		'TypeScript',
		'React',
		'Next.js',
		'Astro',
		'Tailwind CSS',
		'Supabase',
		'Medusa',
		'SEO técnico',
	],
};

const organizationSchema = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#organization`,
	name: BRAND.name,
	legalName: BRAND.legalName,
	alternateName: [BRAND.fullName, `${BRAND.name} — ${BRAND.legalName}`],
	url: `${SITE_URL}/`,
	email: `mailto:${personal.email}`,
	description: 'Estudio freelance de desarrollo web frontend y fullstack (Astro, React, Next.js, TypeScript) de José Manuel Montaño Saenz.',
	logo: {
		'@type': 'ImageObject',
		url: `${SITE_URL}/images/favicon-96x96.png`,
		width: 96,
		height: 96,
	},
	image: `${SITE_URL}/images/og-image.webp`,
	founder: { '@id': `${SITE_URL}/#person` },
	address: postalAddress,
	areaServed: 'Worldwide',
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'sales',
		email: personal.email,
		url: `${SITE_URL}/contact`,
		availableLanguage: ['es', 'en'],
	},
	sameAs: sameAsProfiles,
};

const websiteSchema = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	url: `${SITE_URL}/`,
	name: BRAND.fullName,
	alternateName: [BRAND.name, `${BRAND.legalName} - Desarrollador Frontend`],
	publisher: { '@id': `${SITE_URL}/#organization` },
	description: pageDescription,
	inLanguage: 'es-CO',
	author: {
		'@id': `${SITE_URL}/#person`,
	},
	copyrightYear: currentYear,
};

const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Inicio',
			item: {
				'@type': 'WebPage',
				'@id': `${SITE_URL}/`,
				url: `${SITE_URL}/`,
			},
		},
	],
};

const profilePageSchema = {
	'@type': 'ProfilePage',
	'@id': `${SITE_URL}/#profile`,
	mainEntity: {
		'@id': `${SITE_URL}/#person`,
	},
	dateCreated: '2026-01-01T00:00:00Z',
	dateModified: currentDate,
};

const projectsSchema = {
	'@type': 'ItemList',
	name: 'Proyectos personales',
	itemListElement: projects.map((project, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		item: {
			'@type': 'CreativeWork',
			name: project.name,
			description:
				project.description.length > 160
					? `${project.description.slice(0, 157).trimEnd()}...`
					: project.description,
			url: project.demo || project.repository,
			...(project.repository && { codeRepository: project.repository }),
			author: { '@id': `${SITE_URL}/#person` },
			keywords: project.technologies.map(({ name }) => name).join(', '),
		},
	})),
};

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [personSchema, organizationSchema, websiteSchema, breadcrumbSchema, profilePageSchema, projectsSchema],
};
---

<!doctype html>
<html lang="es-CO">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Color scheme hint -->
		<meta name="color-scheme" content="light dark" />

		<!-- Script para aplicar el tema guardado antes del renderizado -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const saved = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

				const isDark = saved ? saved === 'dark' : prefersDark;

				root.classList.toggle('dark', isDark);
			})();
		</script>

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/images/favicon-96x96.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
		<link rel="manifest" href="/images/site.webmanifest" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen del sitio legible para LLMs" />
		<link rel="alternate" type="text/markdown" href="/index.md" title="Versión Markdown de la página principal" />
		<meta name="msapplication-TileColor" content="#f53b57" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={pageDescription} />
		<meta name="author" content={BRAND.legalName} />
		<meta name="copyright" content={BRAND.name} />
		<meta name="robots" content={robotsContent} />
		<title>{pageTitle}</title>

		<!-- Preload de fuentes críticas para evitar render-blocking -->
		<link rel="preload" href="/fonts/poppins-v23-latin-500.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-v23-latin-600.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-v23-latin-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/poppins-v23-latin-regular.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content={og.type} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:image" content={og.image} />
		<meta property="og:image:type" content="image/webp" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={og.imageAlt} />
		<meta property="og:locale" content={og.locale} />
		<meta property="og:site_name" content={BRAND.fullName} />
		{fbAppId && <meta property="fb:app_id" content={fbAppId} />}

		<!-- Twitter  -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={og.image} />
		<meta name="twitter:image:alt" content={og.imageAlt} />
		<meta name="twitter:site" content="@MooenzDev" />
		<meta name="twitter:creator" content="@MooenzDev" />

		<!-- Google search console  -->
		<meta name="google-site-verification" content="qAWFc7fQ6Gcr1d5vlc-TKfYgqz3_Yl7wGAT_NDUUdBA" />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-MNYDCMVBPH"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(...args) {
				window.dataLayer.push(args);
			}
			gtag('js', new Date());
			gtag('config', 'G-MNYDCMVBPH');
		</script>

		<!-- Datos estructurados del sitio -->
		{
			!noindex && (
				<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
			)
		}
	</head>
	<body>
		<main>
			<slot />
		</main>

		<Footer />

		<!-- Botón volver arriba -->
		<ButtonTop />
	</body>
</html>
