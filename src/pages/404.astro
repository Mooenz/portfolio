---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import IconHouse from '@/assets/icons/IconHouse.astro';
---

<Layout noindex nofollow pageTitle="404 | Página no encontrada" pageDescription="La página que buscas no existe en el portafolio de José Manuel Montaño Saenz.">
	<section class="flex items-center justify-center bg-primary dark:bg-primary-dark transition-colors duration-300 ease-in-out p-3 min-h-dvh">
		<div class="section text-center max-w-xl">
			<h1 class="text-4xl font-bold text-text dark:text-text-dark transition-colors duration-300 ease-in-out title-main"><span class="block relative c404 text-9xl">404</span> Página no encontrada</h1>
			<p class="text-text dark:text-text-dark transition-colors duration-300 ease-in-out my-6 lg:my-8 text-lg">Lo siento, el recurso que buscas no existe. Este sitio es un portafolio de una sola página; a continuación tienes los destinos válidos.</p>

			<nav aria-label="Dónde continuar" class="text-left mx-auto mb-8 inline-block">
				<ul class="list-disc pl-6 space-y-2 text-text dark:text-text-dark transition-colors duration-300 ease-in-out">
					<li><a class="underline underline-offset-2 hover:text-accent" href="/">Inicio</a> — presentación, experiencia y proyectos</li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/about">Sobre mí</a> — trayectoria y forma de trabajo</li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/contact">Contacto</a> — cómo y cuándo escribir</li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/privacy">Privacidad</a></li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/llms.txt">/llms.txt</a> — resumen del sitio para agentes de IA</li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/index.md">/index.md</a> — versión Markdown de la portada</li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/sitemap-index.xml">/sitemap-index.xml</a> — mapa del sitio</li>
					<li><a class="underline underline-offset-2 hover:text-accent" href="/cv.yaml">/cv.yaml</a> — CV en datos estructurados</li>
				</ul>
			</nav>

			<Button href="/" className="w-fit mx-auto" variants="accent" size="md" attr={{ title: 'Ir a la página principal' }}>
				<IconHouse width={16} height={16} class="transition-all ease-in-out duration-300" />
				Página principal
			</Button>
		</div>
	</section>
</Layout>

<style>
	.c404::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		z-index: 10;
		width: 100%;
		height: 100%;
		background: linear-gradient(to top, var(--color-primary) 0%, rgba(255, 0, 0, 0) 100%);
		transition: background 300ms ease-in-out;
	}

	:global(.dark) .c404::before {
		background: linear-gradient(to top, var(--color-primary-dark) 0%, rgba(255, 0, 0, 0) 100%);
	}
</style>
