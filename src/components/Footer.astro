---
import { BRAND } from '@/constants/seo';

const year = new Date().getFullYear();
---

<footer class="bg-primary dark:bg-primary-dark border-t border-border-lateral dark:border-border-lateral-dark transition-[background-color,border-color] duration-300 ease-in-out">
	<div class="mx-auto max-w-5xl px-3 sm:px-6 py-6 flex flex-col gap-4 text-sm text-text-secondary dark:text-text-secondary-dark transition-colors duration-300 ease-in-out">
		<p class="text-center">
			<span class="font-medium text-text dark:text-text-dark transition-colors duration-300 ease-in-out">{BRAND.name}</span> © {year}, todos los derechos reservados.
		</p>
	</div>
</footer>
