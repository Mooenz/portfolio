---
import personal from '@/constants/personal-info';
import { BRAND, SITE_URL, SITE_DOMAIN } from '@/constants/seo';

const year = new Date().getFullYear();

const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/about', label: 'Sobre mí' },
	{ href: '/contact', label: 'Contacto' },
	{ href: '/privacy', label: 'Privacidad' },
	{ href: '/llms.txt', label: 'llms.txt' },
	{ href: '/documents/Cv-José-M-Montaño.pdf', label: 'CV (PDF)' },
];

// NAP canónico (Name, Address, Phone-equivalent). Debe coincidir palabra por
// palabra con el JSON-LD (`Organization`/`Person`) para reforzar que esta marca
// y este dominio son la misma entidad ante buscadores y motores de IA.
const location = `${BRAND.locality}, ${BRAND.region}, ${BRAND.country}`;
---

<footer class="bg-primary dark:bg-primary-dark border-t border-border-lateral dark:border-border-lateral-dark transition-colors duration-300 ease-in-out">
	<div class="mx-auto max-w-5xl px-3 sm:px-6 py-6 flex flex-col gap-4 text-sm text-text-secondary dark:text-text-secondary-dark">
		<p>
			<span class="font-medium text-text dark:text-text-dark">{BRAND.name}</span> © {year}
			{personal.name}
		</p>
	</div>
</footer>
