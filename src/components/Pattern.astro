---
import PatternIcon from '@/assets/icons/Pattern.astro';
---

<svg class="patter w-[120%] h-[120%] absolute -z-10 top-0 left-0 pointer-events-none select-none opacity-15 blur-[1px]" xmlns="http://www.w3.org/2000/svg">
	<defs>
		<PatternIcon patternId="dots" className="text-text dark:text-text-dark transition-colors duration-300 ease-in-out" />
	</defs>
	<rect width="600" height="450" fill="url(#dots)"></rect>
</svg>
