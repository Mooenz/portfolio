---
export interface Props {
	className?: string;
}
const { className = '' }: Props = Astro.props;

// Class base for badge
const classBase = 'transition-colors duration-100 ease-in-out flex items-center gap-2 rounded-full px-3 py-1 text-xs';
---

<span class={`badge ${classBase} ${className}`}>
	<slot />
</span>
