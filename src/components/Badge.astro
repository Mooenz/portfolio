---
export interface Props {
	className?: string;
}
const { className = '' }: Props = Astro.props;

// Class base for badge
const classBase = 'flex items-center gap-2 rounded-full px-3 py-1 text-xs';
---

<span class={`${classBase} ${className} badge`}>
	<slot />
</span>

<style>
	.badge {
		transition:
			background-color 0.3s ease-in-out,
			color 0.3s ease-in-out;
	}
</style>
