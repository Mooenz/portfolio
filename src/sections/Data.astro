---
import Button from '@/components/Button.astro';
import personal from '@/constants/personal-info';
import experience from '@/constants/experience.ts';
import Image from 'astro/components/Image.astro';
import avatar from '@/assets/images/jose-manuel-montaño-saenz.webp';
import LogoLinkedIn from '@/assets/icons/LogoLinkedIn.astro';
import LogoGithub from '@/assets/icons/LogoGitHub.astro';
---

<section class="animate-blurred-fade-in animate-duration-500 flex flex-col aside w-full overflow-x-auto lg:max-w-110 sm:p-6 sm:pt-6 pt-22 p-3 lg:py-8 pb-8 border-r dark:border-border-lateral-dark border-border-lateral items-stretch group overflow-hidden transition-[border-color] duration-300 ease-in-out">
	<!-- Personal information -->
	<section class="" aria-labelledby="about-heading">
		<figure class="relative w-12 lg:w-20 mb-6 aspect-square bg-tertiary dark:bg-tertiary-dark rounded-full transition-[background-color] duration-300 ease-in-out">
			<Image src={avatar} alt={`Foto de ${personal.name}, desarrollador frontend`} width="127" height="127" title={`Avatar de ${personal.name}`} class="rounded-full w-30" />

			<div
				class="pointer-events-none absolute z-100 -translate-y-1/2 top-1/2 left-[calc(100%+12px)] lg:top-[70%] lg:translate-0 lg:left-[calc(100%-14px)] flex items-center bg-accent text-[11px] whitespace-nowrap px-2 rounded-full h-4 lg:w-4 lg:group-hover:w-38 lg:group-focus-within:w-38 transition-all duration-300 ease-in-out lg:group-hover:left-[calc(100%-7px)] lg:group-focus-within:left-[calc(100%-7px)] lg:after:absolute lg:after:-z-1 lg:after:inset-0 lg:after:rounded-[15px] lg:after:bg-accent lg:after:animate-ping lg:after:animate-duration-[3s] lg:group-hover:after:hidden lg:group-focus-within:after:hidden"
			>
				<span class="lg:opacity-0 text-on-accent transition-all duration-300 ease-in-out group-hover:opacity-100 group-hover:delay-300 group-focus-within:opacity-100 group-focus-within:delay-300 overflow-hidden">Disponible para trabajar</span>
			</div>
		</figure>
		<h1 class="title text-2xl font-bold text-text dark:text-text-dark transition-colors duration-300 ease-in-out">{personal.name}</h1>
		<p class="text-lg mb-1 text-text dark:text-text-secondary-dark transition-colors duration-300 ease-in-out">{personal.role}</p>

		<!-- How i am? -->
		<h2 id="about-heading" class="sr-only">Sobre {personal.name} (Mooenz)</h2>
		<p class="element mt-4 sm:mt-7 text-text dark:text-text-dark transition-colors duration-300 ease-in-out">{personal.expertise}</p>

		<!-- Contact -->
		<div class="element flex flex-wrap gap-5 mt-7 order-1">
			<Button variants="normal" href={personal.github} size="sm" attr={{ target: '_blank', rel: 'noopener noreferrer', title: 'Ir a mi perfil de Github' }}>
				<LogoGithub class="transition-transform ease-in-out duration-300" width={18} height={18} />
				<span>Github</span>
			</Button>

			<Button variants="normal" href={personal.linkedIn} size="sm" attr={{ target: '_blank', rel: 'noopener noreferrer', title: 'Ir a mi perfil de LinkedIn' }}>
				<LogoLinkedIn class="transition-transform ease-in-out duration-300" width={18} height={18} />
				<span>LinkedIn</span>
			</Button>
		</div>
	</section>

	<!-- Experience -->
	<section class="order-2" aria-labelledby="experience-heading">
		<h2 id="experience-heading" class="element text-2xl line-clamp-1 font-bold mt-7 lg:mt-14 mb-4 lg:mb-7 text-text dark:text-text-dark transition-colors duration-300 ease-in-out">Experiencia laboral</h2>
		<ul class="relative list-inside space-y-8 pl-6 before:absolute before:left-0 before:top-0 before:h-full before:w-px before:rounded-[20px] dark:before:bg-[linear-gradient(to_top,transparent_0%,var(--color-border-lateral-dark)_30%)] before:bg-[linear-gradient(to_top,transparent_0%,var(--color-border-lateral)_30%)] before:animate-flip-in-y before:animate-delay-400 before:transition-colors before:duration-300 before:ease-in-out">
			{
				experience.map(({ position, description, period, company }, index) => (
					<li class="element text-text dark:text-text-dark transition-colors duration-300 ease-in-out">
						<h3 class="mb-3 line-clamp-1 text-lg font-medium">{position}</h3>

						<p class="text-pretty">
							<span
								class={`relative before:absolute before:-left-8 before:top-1/2 before:size-4 before:-translate-y-1/2 before:rounded-full before:border-4 before:border-primary dark:before:border-primary-dark before:bg-text dark:before:bg-text-dark first:before:bg-accent first:before:outline-1 first:before:outline-accent before:animate-blurred-fade-in before:animate-delay-[${(index + 6) * 100}ms] text-text-secondary dark:text-text-secondary-dark transition-colors duration-100 ease-in-out before:transition-all before:duration-300 before:ease-in-out mb-2 block`}
							>
								{company}, {period}
							</span>
							{description}
						</p>
					</li>
				))
			}
		</ul>
	</section>
</section>

<script>
	import { animateLetters } from '@/utilities/animations.ts';

	// Inicializar cuando el DOM esté listo
	document.addEventListener('DOMContentLoaded', () => {
		// Inicializar animaciones
		animateLetters('.title');
	});
</script>
