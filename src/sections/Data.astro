---
import Button from '@/components/Button.astro';
import personal from '@/constants/personal-info';
import experience from '@/constants/experience.ts';
import Image from 'astro/components/Image.astro';
import avatar from '@/assets/images/jose-manuel-montaño-saenz.webp';
import LogoLinkedIn from '@/assets/icons/LogoLinkedIn.astro';
import LogoGithub from '@/assets/icons/LogoGitHub.astro';
---

<section class="animate-blurred-fade-in animate-duration-300 ripple-container flex flex-col aside w-full overflow-x-auto lg:max-w-110 sm:p-6 sm:pt-6 pt-22 p-3 lg:py-8 pb-8 border-r dark:border-border-lateral-dark border-border-lateral items-stretch group overflow-hidden transition-colors duration-300 ease-in-out">
	<!-- Personal information -->
	<div class="">
		<figure class="ripple-figure relative w-12 lg:w-20 mb-6 aspect-square bg-tertiary dark:bg-tertiary-dark rounded-full transition-colors duration-300 ease-in-out">
			<Image src={avatar} alt="Avatar" width="127" height="127" title={`Avatar de ${personal.name}`} class="rounded-full w-30" />

			<div class="ripple pointer-events-none absolute z-100 -translate-y-1/2 top-1/2 left-[calc(100%+12px)] lg:top-[70%] lg:translate-0 lg:left-[calc(100%-14px)] flex items-center bg-green-400 dark:bg-green-400/10 lg:dark:bg-green-400 lg:bg-green-400 text-[11px] whitespace-nowrap px-2 rounded-full h-4 lg:w-4 lg:group-hover:w-38 transition-all duration-300 ease-in-out group-hover:dark:bg-green-400/10 lg:group-hover:left-[calc(100%-7px)]">
				<span class="lg:opacity-0 text-dark dark:text-green-400 group-hover:opacity-100 group-hover:transition-all group-hover:duration-300 group-hover:ease-in-out group-hover:delay-300">Disponible para trabajar</span>
			</div>
		</figure>
		<h1 class="title text-2xl font-bold dark:text-text-dark transition-colors duration-300 ease-in-out">{personal.name}</h1>
		<p class="text-lg mb-1 dark:text-text-secondary-dark transition-colors duration-300 ease-in-out">{personal.role}</p>

		<!-- How i am? -->
		<p class="element mt-4 sm:mt-7 dark:text-text-dark transition-colors duration-300 ease-in-out" style="--delay: 0ms">{personal.expertise}</p>

		<!-- Contact -->
		<div class="element flex flex-wrap gap-5 mt-7 order-1" style="--delay: 100ms">
			<Button variants="normal" href={personal.github} size="sm" attr={{ target: '_blank', rel: 'noopener noreferrer', title: 'Ir a mi perfil de Github' }}>
				<LogoGithub class="transition-all ease-in-out duration-300" width={18} height={18} />
				<span>Github</span>
			</Button>

			<Button variants="normal" href={personal.linkedIn} size="sm" attr={{ target: '_blank', rel: 'noopener noreferrer', title: 'Ir a mi perfil de LinkedIn' }}>
				<LogoLinkedIn class="transition-all ease-in-out duration-300" width={18} height={18} />
				<span>LinkedIn</span>
			</Button>
		</div>
	</div>

	<!-- Experience -->
	<div class="order-2">
		<h2 class="element text-2xl line-clamp-1 font-bold mt-7 lg:mt-14 mb-4 lg:mb-7 dark:text-text-dark transition-colors duration-300 ease-in-out" style="--delay: 0ms">Experiencia laboral</h2>
		<ul class="line list-inside space-y-8 before:animate-flip-in-y before:animate-delay-400">
			{
				experience.map(({ position, description, period, company }, index) => (
					<li class="element dark:text-text-dark transition-colors duration-300 ease-in-out" style="--delay: 100ms">
						<h3 class="mb-3 line-clamp-1 text-lg font-medium">{position}</h3>

						<p class="text-pretty">
							<span class={`line-circle before:animate-blurred-fade-in before:animate-delay-[${(index + 6) * 100}ms] before:bg-text dark:before:bg-text-dark text-text-secondary dark:text-text-secondary-dark transition-colors duration-300 ease-in-out dark:before:border-primary-dark before:border-primary before:border-4 before:transition-all before:duration-300 before:ease-in-out mb-2 block`}>
								{company}, {period}
							</span>
							{description}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	import { animateLetters } from '@/utilities/animations.ts';

	// Inicializar cuando el DOM esté listo
	document.addEventListener('DOMContentLoaded', () => {
		// Inicializar animaciones
		animateLetters('.title');
	});
</script>

<style>
	.line {
		position: relative;
		padding-left: 24px;
		/* border-left: 1px solid var(--color-line-lateral); */
	}

	.line::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		border-radius: 20px;
		height: 100%;
		background: linear-gradient(to top, rgb(0, 0, 0, 0) 0%, var(--color-line-lateral) 30%);
	}

	.line-circle {
		position: relative;
	}

	.line-circle::before {
		content: '';
		position: absolute;
		left: -32px;
		top: 50%;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		transform: translateY(-50%);
	}

	.line li:first-of-type .line-circle:before {
		background-color: var(--color-accent);
		outline: 1px solid var(--color-accent);
	}

	@media (min-width: 1024px) {
		.ripple-container:hover .ripple::after {
			display: none;
			animation-play-state: paused;
		}

		.ripple::after {
			content: '';
			position: absolute;
			z-index: -1;
			width: 100%;
			height: 100%;
			background-color: var(--color-green-400);
			border-radius: 15px;
			animation: ripple 6.5s infinite ease-in-out;
			top: 0;
			left: 0;
		}

		@keyframes ripple {
			0% {
				transform: scale(1);
				opacity: 1;
			}
			23% {
				transform: scale(2);
				opacity: 0;
			}
			23%,
			100% {
				transform: scale(2);
				opacity: 0;
			}
		}
	}
</style>
