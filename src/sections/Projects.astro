---
import projects from '@/constants/projects.ts';
import Project from '@/components/Project.astro';
---

<section class="lg:mt-9 animate-blurred-fade-in animate-duration-300">
	<h2 class="element text-2xl font-bold mb-6 dark:text-text-dark transition-colors duration-300 ease-in-out" style="--delay: 0ms">Proyectos personales</h2>
	<div class="element flex flex-col gap-6 md:gap-10 lg:gap-15 lg:mt-15" style="--delay: 100ms">
		{projects.map(({ name, description, technologies, repository, demo, image }) => <Project image={image} name={name} description={description} technologies={technologies} repository={repository} demo={demo} />)}
	</div>
</section>

<script>
	import { scrollItems } from '@/utilities/animations.ts';

	// Inicializar cuando el DOM esté listo
	document.addEventListener('DOMContentLoaded', () => {
		// Inicializar animaciones
		scrollItems('.project');
	});
</script>
