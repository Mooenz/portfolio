---
import Button from '@/components/Button.astro';
import IconDownload from '@/assets/icons/IconDownload.astro';
import IconMoon from '@/assets/icons/iconMoon.astro';
import IconSun from '@/assets/icons/iconSun.astro';
---

<div class="animate-blurred-fade-in animate-duration-500 absolute lg:static top-3 right-3 sm:top-6 sm:right-6 flex gap-4 items-center justify-end" id="menu-principal">
	<button
		class="cursor-pointer active:scale-90 w-14 h-14 bg-tertiary dark:bg-secondary-dark rounded-full flex items-center justify-center hover:bg-text focus:bg-text focus-visible:bg-text dark:hover:bg-text-dark dark:focus:bg-text-dark dark:focus-visible:bg-text-dark transition-all ease-in-out duration-300 group border-4 border-primary dark:border-primary-dark outline-2 outline-primary dark:outline-primary-dark hover:outline-primary-dark dark:hover:outline-primary focus:outline-primary-dark dark:focus:outline-primary focus-visible:outline-primary-dark dark:focus-visible:outline-primary"
		id="btn-toggle-theme"
		aria-label="Tema oscuro"
		aria-pressed="false"
	>
		<IconMoon width={18} height={18} class="icon text-on-surface dark:text-on-surface-dark group-hover:text-primary group-focus:text-primary group-focus-visible:text-primary icon-moon transition-all ease-in-out duration-300" />
		<IconSun width={18} height={18} class="icon text-on-surface dark:text-on-surface-dark group-hover:text-primary group-focus:text-primary group-focus-visible:text-primary dark:group-hover:text-primary-dark dark:group-focus:text-primary-dark dark:group-focus-visible:text-primary-dark icon-sun transition-all ease-in-out duration-300" />
	</button>

	<Button href="/documents/Cv-José-M-Montaño.pdf" variants="accent" size="md" attr={{ title: 'Descargar curriculum en formato PDF', id: 'btn-principal', download: 'Cv-José-M-Montaño' }}>
		<IconDownload width={18} height={18} class="transition-transform ease-in-out duration-300" />
		<span>Curriculum</span>
	</Button>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const btnToggleTheme = document.getElementById('btn-toggle-theme') as HTMLButtonElement;

		if (btnToggleTheme) {
			// El estado real lo fija el script en línea del <head>, así que se
			// sincroniza aquí en la primera carga y en cada pulsación.
			btnToggleTheme.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));

			btnToggleTheme.addEventListener('click', () => {
				document.documentElement.classList.toggle('dark');

				const isDark = document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
				btnToggleTheme.setAttribute('aria-pressed', String(isDark));

				// aztec-900 / aztec-50: mantiene la UI del navegador en sincronía.
				document.getElementById('meta-theme-color')?.setAttribute('content', isDark ? '#1a1c1c' : '#ecf2f2');
			});
		}
	});
</script>
